# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
HOST_PORT=3000

# ── Anthropic (Claude) ───────────────────────────────────────────────────────
# IMPORTANTE: cada cliente DEBE tener su propia API key de Anthropic.
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024

# ── Groq (transcripción de audios con Whisper) ───────────────────────────
# Gratis en https://console.groq.com — necesaria para que el bot entienda audios.
GROQ_API_KEY=tu-groq-api-key

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Dentro de docker-compose el host es "db" (nombre del servicio).
POSTGRES_DB=recepcionista_db
POSTGRES_USER=recepcionista_user
POSTGRES_PASSWORD=cambiar-esta-clave
DATABASE_URL=postgresql://recepcionista_user:cambiar-esta-clave@db:5432/recepcionista_db

# ── Evolution API (WhatsApp) ─────────────────────────────────────────────
# URL base de tu instancia de Evolution API y su api key global/instancia.
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=tu-api-key
EVOLUTION_INSTANCE=nombre-de-tu-instancia

# Token propio para validar que el webhook viene de tu Evolution API
# (lo agregás como query param ?token=... al configurar el webhook en Evolution).
WEBHOOK_VERIFY_TOKEN=un-token-secreto-inventado-por-vos

# ── Dashboard ────────────────────────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambiar-esta-clave
# Base path para acceso via Nginx reverse proxy (ej: /simaxface).
# Dejar vacío si no se usa reverse proxy.
BASE_PATH=

# ── Negocio ──────────────────────────────────────────────────────────────
# Teléfono del dueño/recepcionista para recibir notificaciones de turnos y derivaciones.
RECEPTIONIST_PHONE=5492235551234
# Teléfono para alertas de desconexión (opcional, usa RECEPTIONIST_PHONE si no se pone).
# ALERT_PHONE=5492235551234

# ── Integraciones ────────────────────────────────────────────────────────
# URL de webhook externo para n8n/Zapier/Make (opcional).
# Recibe POST con eventos: new_appointment, cancelled_appointment, completed_appointment
# WEBHOOK_EXTERNAL_URL=https://tu-n8n.com/webhook/xxxxx
